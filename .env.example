# Upstash Redis (required for shared named navs)
# Create via Vercel Marketplace → Upstash, or https://console.upstash.com
# Then either:
#   npx vercel env pull .env.local
# or paste:

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Also accepted (Vercel KV-style aliases):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
